<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TODOリスト | My Express Site</title>
  <link rel="stylesheet" href="/todo/style.css">
  <script src="/todo/todo.js" defer></script>
</head>
<body><main>
  <a href="/">← トップページ</a>
  <h1>TODOリスト</h1>
  <p>授業用の共有リストです。架空のタスクだけを入力してください。</p>
  <form id="new-todo"><label for="title">新しいTODO</label>
    <div class="entry"><input id="title" name="title" required placeholder="例：演習の結果を確認する"><button>追加</button></div>
    <small>前後の空白を除いて1〜100文字</small>
  </form>
  <h2>一覧</h2>
  <p id="notice" role="status" aria-live="polite"></p>
  <p id="empty" hidden>TODOがありません</p>
  <ul id="tasks"></ul>
  <button id="reload" type="button">一覧を再取得</button>
</main></body></html>
